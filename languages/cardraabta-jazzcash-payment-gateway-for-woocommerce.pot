#. Plugin Name of the plugin
#: cardraabta-jazzcash-payment-gateway-for-woocommerce.php
msgid "CardRaabta – JazzCash Payment Gateway for WooCommerce"
msgstr ""

#. Description of the plugin
#: cardraabta-jazzcash-payment-gateway-for-woocommerce.php
msgid "Accept JazzCash wallet and debit/credit card payments in WooCommerce, with Sandbox/Live modes, signed callbacks and configurable expiry."
msgstr ""

#. Author of the plugin
#: cardraabta-jazzcash-payment-gateway-for-woocommerce.php
msgid "Malik Arslan"
msgstr ""

#. Author URI of the plugin
#: cardraabta-jazzcash-payment-gateway-for-woocommerce.php
msgid "https://malikarslan.com"
msgstr ""

#: cardraabta-jazzcash-payment-gateway-for-woocommerce.php:22
msgid "Deactivate the previous JazzCash Card Gateway plugin before activating this release. Settings and order records are retained."
msgstr ""

#: cardraabta-jazzcash-payment-gateway-for-woocommerce.php:48
msgid "When you choose JazzCash, the order reference, amount, currency, payment timestamps and return address are sent to JazzCash to process your payment. Card and wallet information is entered on JazzCash; wallet payment approval takes place on your phone. Payment references and status are retained with your order. This plugin does not add analytics or advertising trackers. Contact the store regarding order retention and privacy requests."
msgstr ""

